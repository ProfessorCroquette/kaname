---
import '../styles/global.css';
const { title = "Project Kaname" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=Fragment+Mono&display=swap" rel="stylesheet">
  </head>
  <body>
    <header class="site-header">
      <!-- Hardcoded paths for GitHub Pages -->
      <a href="/kaname/">
        <img id="logo" src="/kaname/images/logo1.png" alt="Project Kaname">
      </a>
      <nav>
        <ul>
          <li><a href="/kaname/">Home</a></li>
          <li><a href="/kaname/#about">About</a></li>
          <li><a href="/kaname/#contact">Contact</a></li>
          <li><a href="/kaname/analyses">Analyses</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; 2026 Project Kaname. All rights reserved.</p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--bg);
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--border);
  }
  #logo {
    height: 28px;
    width: auto;
    filter: brightness(0) invert(1);
  }
  nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    list-style: none;
  }
  nav a {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  nav a:hover {
    color: var(--accent-hover);
  }
  .site-footer {
    padding: var(--space-lg);
    text-align: center;
    border-top: 1px solid var(--border);
  }
  .site-footer p {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    color: var(--text-soft);
    margin: 0 auto;
  }
</style>
