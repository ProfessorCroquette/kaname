---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const allAnalyses = await getCollection('analyses');
const sortedAnalyses = allAnalyses.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="All Analyses | Project Kaname">
  <section class="section">
    <div class="container">
      <h1>All Analyses</h1>

      <div class="masonry-grid">
        {sortedAnalyses.map((analysis) => (
          <article class="grid-card">
            <h2>
              <a href={`${base}analyses/${analysis.id}`}>{analysis.data.title}</a>
            </h2>
            <p class="meta">
              {analysis.data.date.toLocaleDateString()} · {analysis.data.category}
            </p>
            <p>{analysis.data.description}</p>
          </article>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border);
  }

  /* MASONRY GRID */
  .masonry-grid {
    column-count: 3;
    column-gap: var(--space-lg);
    break-inside: avoid;
  }

  @media (max-width: 900px) { .masonry-grid { column-count: 2; } }
  @media (max-width: 600px) { .masonry-grid { column-count: 1; } }

  .grid-card {
    display: inline-block;
    width: 100%;
    margin-bottom: var(--space-lg);
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-lg);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .grid-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }

  .grid-card h2 {
    font-size: 1.5rem;
    margin: 0 0 var(--space-sm) 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .grid-card a {
    color: var(--text);
    text-decoration: none;
  }

  .grid-card a:hover {
    color: var(--accent-hover);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-soft);
    margin-bottom: var(--space-sm);
  }

  .grid-card p:last-child {
    color: var(--text-soft);
    margin-bottom: 0;
    max-width: 100%;
    line-height: 1.6;
  }
</style>
