---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const analyses = await getCollection('analyses');
  return analyses.map(entry => ({
    params: { slug: entry.id }, // Astro v6 uses entry.id, not entry.slug
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry); // Astro v6 uses this instead of entry.render()
---

<BaseLayout title={`${entry.data.title} — Project Kaname`}>
  <article class="article-container">

    <header class="article-header">
      <h1>{entry.data.title}</h1>
      <div class="article-meta-row">
        <span class="meta">{entry.data.date.toLocaleDateString()} · {entry.data.category}</span>
        <span class="article-author">By Professor Croquette</span>
      </div>
    </header>

    <div class="article-body">
      <Content />
    </div>

  </article>
</BaseLayout>

<style>
  .article-container {
    max-width: 72ch;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg);
  }

  .article-header {
    margin-bottom: var(--space-xl);
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-md);
  }

  .article-header h1 {
    font-size: 2.5rem;
    margin-top: 0;
    margin-bottom: var(--space-sm);
    line-height: 1.2;
  }

  .article-meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta {
    color: var(--text-soft);
    margin: 0;
  }

  .meta::after {
    content: "•";
    margin-left: var(--space-sm);
    color: var(--text-soft);
  }

  .article-author {
    color: var(--accent);
    margin: 0;
  }

  /* MARKDOWN TYPOGRAPHY */
  .article-body :global(p) {
    font-family: var(--font-body);
    font-size: 1.15rem;
    line-height: 1.8;
    margin-bottom: var(--space-lg);
    color: var(--text);
    max-width: 100%;
  }

  .article-body :global(p + p) {
    text-indent: 1.5em;
    margin-bottom: var(--space-md);
  }

  .article-body :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
    color: var(--text);
  }

  .article-body :global(h2::before) {
    content: "■";
    color: var(--accent);
    margin-right: var(--space-sm);
    font-size: 0.8em;
    vertical-align: middle;
  }

  .article-body :global(p:first-of-type::first-letter) {
    font-family: var(--font-body);
    font-size: 4em;
    float: left;
    line-height: 0.8;
    padding-right: 0.1em;
    color: var(--accent);
  }
</style>
